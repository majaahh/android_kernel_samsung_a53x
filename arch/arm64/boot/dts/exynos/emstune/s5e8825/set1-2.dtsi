/ {
	/* power-scenario mode - app boost */
	set1_2: set@0102 {
		frt {	   			/* LIT BIG */
			active-ratio 		= < 25   5>;
		};

		tex {
			top-app		= <1>;
			prio		= <112>;
		};

		gsc {
			up_threshold = <0>;

			monitor-group {
				top-app = <1>;
				foreground = <1>;
			};
		};

		should_spread {
			enabled = <1>;
		};

		ecs_dynamic { };
	};
};
