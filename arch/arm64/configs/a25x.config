# Battery
CONFIG_BATTERY_LOGGING=y

# Camera
CONFIG_CAMERA_AAW_A25X=y
CONFIG_CAMERA_ACT_AK737X_OBJ=m
CONFIG_CAMERA_CIS_4HA_OBJ=m
CONFIG_CAMERA_CIS_GC02M1_OBJ=m
CONFIG_CAMERA_CIS_HI1339_OBJ=m
CONFIG_CAMERA_CIS_IMX258_OBJ=m
CONFIG_CAMERA_CIS_JN1_OBJ=m
CONFIG_CAMERA_USE_AOIS=y
CONFIG_CAMERA_USE_MCU=y
CONFIG_OIS_USE=y

# Camera - Flash
CONFIG_CAMERA_FLASH_S2MF301_OBJ=m

# Charger
CONFIG_CHARGER_HL7132=m
CONFIG_CHARGER_S2MF301=m
CONFIG_HICCUP_CHARGER=y
CONFIG_SUPPORT_HV_CTRL=y

# DRM
CONFIG_DRM_SAMSUNG_DOZE=y

# Device
CONFIG_SEC_A25=y

# Exynos
CONFIG_EXYNOS_FREQ_HOP=m

# Fingerprint
CONFIG_SENSORS_EC6XX=m

# Fuelgauge
CONFIG_FUELGAUGE_S2MF301=m
CONFIG_FUELGAUGE_S2MF301_USE_5MILLIOHM=y

# Hiccup
CONFIG_HICCUP_CC_DISABLE=y

# Leds
CONFIG_LEDS_S2MF301_FLASH=m

# MFD
CONFIG_MFD_S2MF301=m

# MUIC
CONFIG_HV_MUIC_S2MF301_AFC=m
CONFIG_HV_MUIC_VOLTAGE_CTRL=y
CONFIG_MUIC_AFC_RETRY=y
CONFIG_MUIC_COMMON_SYSFS=y
CONFIG_MUIC_PLATFORM=m
CONFIG_MUIC_S2MF301=m
CONFIG_MUIC_S2MF301_RID=y
CONFIG_MUIC_SUPPORT_POWERMETER=y
CONFIG_MUIC_SUPPORT_PRSWAP=y
CONFIG_MUIC_USE_MODULE_PARAM=y

# NFC
CONFIG_NFC_ST21NFC=y
CONFIG_SAMSUNG_NFC=m
CONFIG_SEC_NFC_LOGGER=y

# NFC - SNVM
CONFIG_STAR_K250A_LEGO=m
CONFIG_SEC_SNVM_PLATFORM_DRV=y

# PDIC
CONFIG_PDIC_PD30=y
CONFIG_PDIC_S2MF301=m
CONFIG_PDIC_SLSI_NON_MCU=m
CONFIG_S2MF301_PDIC_TRY_SNK=y

# PM
CONFIG_PM_S2MF301=m

# PMIC
CONFIG_LSI_IFPMIC=y

# Panel
CONFIG_SEC_PANEL_NOTIFIER_V2=m

# Panel - USDM
CONFIG_USDM_FACTORY_CCD_TEST=y
CONFIG_USDM_FACTORY_DSC_CRC_TEST=y
CONFIG_USDM_FACTORY_ECC_TEST=y
CONFIG_USDM_MDNIE=y
CONFIG_USDM_PANEL=m
CONFIG_USDM_PANEL_AOD_BL=y
CONFIG_USDM_PANEL_DEBUG=y
CONFIG_USDM_PANEL_DIMMING=y
CONFIG_USDM_PANEL_DISPLAY_MODE=y
CONFIG_USDM_PANEL_DPUI=y
CONFIG_USDM_PANEL_FREQ_HOP=y
CONFIG_USDM_PANEL_ID_READ_REG_04=y
CONFIG_USDM_PANEL_ID_READ_BY_HSDT=y
CONFIG_USDM_PANEL_JSON=y
CONFIG_USDM_PANEL_LPM=y
CONFIG_USDM_PANEL_OLED_COMMON=m
CONFIG_USDM_PANEL_S6E3FC3=m
CONFIG_USDM_PANEL_SELF_DISPLAY=y
CONFIG_USDM_PANEL_SYSFS=y

# Radio
CONFIG_RADIO_S5E8825=m
CONFIG_RADIO_S620=m

# SEC
CONFIG_SEC_ABC_MOTTO=m

# Sensors
CONFIG_SENSORS_A96T396=m
CONFIG_SENSORS_A96T396_2CH=y
CONFIG_SENSORS_FW_VENDOR=y

# Sound
CONFIG_SND_SOC_RL6231=m
CONFIG_SND_SOC_RT5665=m
CONFIG_SND_SOC_RT5691=m
CONFIG_SND_SOC_SAMSUNG_EXYNOS8825_RT5665=m
CONFIG_SND_SOC_SAMSUNG_EXYNOS8825_RT5691=m

# Sound - Abox
CONFIG_SND_SOC_SAMSUNG_MAILBOX=m
CONFIG_SND_SOC_SAMSUNG_SLIF=m
CONFIG_SND_SOC_SAMSUNG_SLIF_VERSION=0x10101
CONFIG_SND_SOC_SAMSUNG_VTS=m
CONFIG_SND_SOC_SAMSUNG_VTS_VERSION=0x20100
CONFIG_SND_SOC_SAMSUNG_VTS_V2_1=y

# Shub
CONFIG_SHUB_AOIS=y

# TOP
CONFIG_TOP_S2MF301=m

# Touchscreen
CONFIG_TOUCHSCREEN_FTS_FT3519=m

# User Interface
CONFIG_UI_SOC_PROLONGING=y
